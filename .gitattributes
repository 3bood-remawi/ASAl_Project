# Normalize line endings so the repo is identical for everyone regardless of OS.
# Without this, Windows clones with core.autocrlf=true can refuse commits
# ("fatal: LF would be replaced by CRLF") and diffs show whole files as changed.
* text=auto eol=lf

# Files that must keep CRLF to work on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
